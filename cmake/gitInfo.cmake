# Writes ${OUT} with the current git commit, branch and whether there are uncommitted changes.
# Run at every build (see the sams_git_info target in CMakeLists.txt). The file is only rewritten
# when its contents change, so an unchanged tree does not trigger recompilation.
#
# Inputs: SRC (source directory), OUT (header to write)

set(GIT_HASH "unknown")
set(GIT_BRANCH "unknown")
set(GIT_DIRTY "unknown")

find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=12 HEAD
                  WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE _hash RESULT_VARIABLE _r1
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(_r1 EQUAL 0)
    set(GIT_HASH "${_hash}")
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD
                    WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE GIT_BRANCH
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    # Tracked files only: build products and logs in the source tree do not count as changes
    execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
                    WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE _status
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_status STREQUAL "")
      set(GIT_DIRTY "no")
    else()
      set(GIT_DIRTY "yes")
    endif()
  endif()
endif()

set(_content "// Generated by cmake/gitInfo.cmake. Do not edit.
#define SAMS_GIT_HASH \"${GIT_HASH}\"
#define SAMS_GIT_BRANCH \"${GIT_BRANCH}\"
#define SAMS_GIT_DIRTY \"${GIT_DIRTY}\"
")

if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
else()
  set(_old "")
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT}" "${_content}")
endif()
